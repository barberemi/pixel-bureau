{
 "kind": "workflow",
 "key": "office",
 "definition": {
  "name": "Le Bureau · refresh (page)",
  "project_id": "@@kronn.project_id@@",
  "trigger": {
   "type": "Cron",
   "schedule": "*/10 @@cron_hours@@ * * *"
  },
  "steps": [
   {
    "name": "snapshot",
    "step_type": {
     "type": "CollectApiData"
    },
    "description": "1/3 · Déterministe (0 token) : lit l'API locale Kronn (workflows, runs du jour, discussions) et sort l'instantané office en JSON.",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "collect_api_data": {
     "sources": [
      {
       "alias": "snap",
       "quick_api_id": "",
       "quick_exec_id": "",
       "quick_exec": {
        "command": "python3",
        "args": [
         "-c",
         "@@script:workflows/office_snapshot.py@@"
        ],
        "timeout_secs": 150,
        "output_format": "json"
       },
       "required": true
      }
     ],
     "concurrent_limit": 1
    }
   },
   {
    "name": "statuts",
    "step_type": {
     "type": "CollectApiData"
    },
    "description": "2/3 · Déterministe (0 token) : lit les pages de statut publiques des services extérieurs (GitHub, Claude, Jira, Confluence par défaut, réglage statuts) et sort leur état et leurs incidents datés.",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "collect_api_data": {
     "sources": [
      {
       "alias": "snap",
       "quick_api_id": "",
       "quick_exec_id": "",
       "quick_exec": {
        "command": "python3",
        "args": [
         "-c",
         "@@script:workflows/statuts_snapshot.py@@"
        ],
        "timeout_secs": 120,
        "output_format": "json"
       },
       "required": true
      }
     ],
     "concurrent_limit": 1
    }
   },
   {
    "name": "publish",
    "step_type": {
     "type": "PublishPageData"
    },
    "description": "3/3 · Remplace les datasets office et statuts de la page Le Bureau.",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "page_publish": {
     "page_id": "@@page_id@@",
     "writes": [
      {
       "dataset": "office",
       "operation": "replace",
       "value_from": "steps.snapshot.data.sources.snap"
      },
      {
       "dataset": "statuts",
       "operation": "replace",
       "value_from": "steps.statuts.data.sources.snap"
      }
     ]
    }
   }
  ],
  "actions": [],
  "safety": {
   "sandbox": false,
   "require_approval": false
  },
  "workspace_config": {
   "hooks": {},
   "require_isolation": false,
   "main_tree_read_only": true
  },
  "concurrency_limit": null,
  "exec_allowlist": [
   "python3"
  ]
 }
}