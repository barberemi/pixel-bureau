{
 "kind": "workflow",
 "key": "redaction_bilan",
 "doc": "Bilan de la rédaction : l'historique des intentions du 2e étage et des tickets créés, postes, critique, tampon et projets (page « Rédaction · bilan »).",
 "definition": {
  "name": "Le Bureau · bilan de la rédaction (15 min)",
  "project_id": "@@kronn.project_id@@",
  "trigger": {
   "type": "Cron",
   "schedule": "13-59/15 @@cron_hours@@ * * 1-5"
  },
  "steps": [
   {
    "name": "releve",
    "step_type": {
     "type": "Exec"
    },
    "description": "L'API Kronn : agents de chaque intention et de ses postes (durée, jetons, coût, modèle), passages au tampon, créations ; un run fini est gardé en cache (0 token).",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "exec_command": "python3",
    "exec_args": [
     "-c",
     "@@script:workflows/redaction_bilan.py@@",
     "releve"
    ],
    "exec_timeout_secs": 300
   },
   {
    "name": "bilan",
    "step_type": {
     "type": "Exec"
    },
    "description": "Historique et relevé assemblés en dataset : une ligne par intention, fiches des plus récentes, notes de la critique et tes retours classés (0 token).",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "exec_command": "python3",
    "exec_args": [
     "-c",
     "@@script:workflows/redaction_bilan.py@@",
     "bilan"
    ],
    "exec_timeout_secs": 120
   },
   {
    "name": "publish",
    "step_type": {
     "type": "PublishPageData"
    },
    "description": "Remplace le dataset redaction_bilan de la page « Rédaction · bilan ».",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "page_publish": {
     "page_id": "@@redaction_bilan.page_id@@",
     "writes": [
      {
       "dataset": "redaction_bilan",
       "operation": "replace",
       "value_from": "steps.bilan.data.stdout"
      }
     ]
    }
   }
  ],
  "actions": [],
  "safety": {
   "sandbox": false,
   "require_approval": false
  },
  "workspace_config": {
   "hooks": {},
   "require_isolation": false,
   "main_tree_read_only": true
  },
  "concurrency_limit": null,
  "exec_allowlist": [
   "python3"
  ]
 }
}
