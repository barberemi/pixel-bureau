{
 "kind": "workflow",
 "key": "live",
 "definition": {
  "name": "Le Bureau · live (1 min)",
  "project_id": "@@kronn.project_id@@",
  "trigger": {
   "type": "Cron",
   "schedule": "* @@cron_hours@@ * * *"
  },
  "steps": [
   {
    "name": "snapshot",
    "step_type": {
     "type": "CollectApiData"
    },
    "description": "Runs en cours, discussions récentes, déploiements du jour (0 token).",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "collect_api_data": {
     "sources": [
      {
       "alias": "snap",
       "quick_api_id": "",
       "quick_exec_id": "",
       "quick_exec": {
        "command": "python3",
        "args": [
         "-c",
         "@@script:workflows/live_snapshot.py@@"
        ],
        "timeout_secs": 150,
        "output_format": "json"
       },
       "required": true
      }
     ],
     "concurrent_limit": 1
    }
   },
   {
    "name": "gates",
    "step_type": {
     "type": "CollectApiData"
    },
    "description": "Gates en attente (JSON typé) pour les décider depuis la page.",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "collect_api_data": {
     "sources": [
      {
       "alias": "snap",
       "quick_api_id": "",
       "quick_exec_id": "",
       "quick_exec": {
        "command": "python3",
        "args": [
         "-c",
         "@@script:workflows/gates_snapshot.py@@"
        ],
        "timeout_secs": 30,
        "output_format": "json"
       },
       "required": true
      }
     ],
     "concurrent_limit": 1
    }
   },
   {
    "name": "publish",
    "step_type": {
     "type": "PublishPageData"
    },
    "description": "Remplace le dataset live de la page Le Bureau.",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "page_publish": {
     "page_id": "@@page_id@@",
     "writes": [
      {
       "dataset": "live",
       "operation": "replace",
       "value_from": "steps.snapshot.data.sources.snap"
      },
      {
       "dataset": "gates",
       "operation": "replace",
       "value_from": "steps.gates.data.sources.snap"
      }
     ]
    }
   },
   {
    "name": "todos",
    "step_type": {
     "type": "CollectApiData"
    },
    "description": "Mes todos : tâches Kronn taguées bureau-todo, pour le tableau en liège (0 token).",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "collect_api_data": {
     "sources": [
      {
       "alias": "snap",
       "quick_api_id": "",
       "quick_exec_id": "",
       "quick_exec": {
        "command": "python3",
        "args": [
         "-c",
         "@@script:workflows/todos.py@@"
        ],
        "timeout_secs": 30,
        "output_format": "json"
       },
       "required": true
      }
     ],
     "concurrent_limit": 1
    }
   },
   {
    "name": "publish_todos",
    "step_type": {
     "type": "PublishPageData"
    },
    "description": "Remplace le dataset todos de la page Le Bureau.",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "page_publish": {
     "page_id": "@@page_id@@",
     "writes": [
      {
       "dataset": "todos",
       "operation": "replace",
       "value_from": "steps.todos.data.sources.snap"
      }
     ]
    }
   },
   {
    "name": "atelier",
    "step_type": {
     "type": "CollectApiData"
    },
    "description": "Bureaux de l'atelier d'implémentation (1er étage) : runs de la chaîne et de ses postes, 0 token.",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "collect_api_data": {
     "sources": [
      {
       "alias": "snap",
       "quick_api_id": "",
       "quick_exec_id": "",
       "quick_exec": {
        "command": "python3",
        "args": [
         "-c",
         "@@script:workflows/atelier_snapshot.py@@"
        ],
        "timeout_secs": 30,
        "output_format": "json"
       },
       "required": false
      }
     ],
     "concurrent_limit": 1
    },
    "_requires": "models.impl_chain"
   },
   {
    "name": "publish_atelier",
    "step_type": {
     "type": "PublishPageData"
    },
    "description": "Remplace le dataset atelier de la page Le Bureau.",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "page_publish": {
     "page_id": "@@page_id@@",
     "writes": [
      {
       "dataset": "atelier",
       "operation": "replace",
       "value_from": "steps.atelier.data.sources.snap"
      }
     ]
    },
    "_requires": "models.impl_chain"
   }
  ],
  "actions": [],
  "safety": {
   "sandbox": false,
   "require_approval": false
  },
  "workspace_config": {
   "hooks": {},
   "require_isolation": false,
   "main_tree_read_only": true
  },
  "concurrency_limit": null,
  "exec_allowlist": [
   "python3",
   "gh"
  ]
 }
}
