{
 "kind": "workflow",
 "key": "gate",
 "definition": {
  "name": "Le Bureau · décision gate",
  "project_id": "@@kronn.project_id@@",
  "trigger": {
   "type": "Manual"
  },
  "variables": [
   {
    "name": "run_id",
    "label": "Gate",
    "placeholder": "",
    "description": null,
    "required": true,
    "source": null,
    "allow_manual_override": false
   },
   {
    "name": "decision",
    "label": "Décision",
    "placeholder": "",
    "description": "Ce que tu décides pour cette gate",
    "required": true,
    "source": null,
    "allow_manual_override": false,
    "control": {
     "type": "select",
     "options": [
      {
       "value": "approve",
       "label": "✅ Approuver",
       "enabled": true
      },
      {
       "value": "reject",
       "label": "⛔ Rejeter",
       "enabled": true
      },
      {
       "value": "request_changes",
       "label": "✏️ Demander des changements",
       "enabled": true
      }
     ],
     "default_value": "approve"
    }
   },
   {
    "name": "comment",
    "label": "Commentaire",
    "placeholder": "Facultatif (obligatoire pour demander des changements)",
    "description": null,
    "required": false,
    "source": null,
    "allow_manual_override": false,
    "control": {
     "type": "textarea"
    }
   }
  ],
  "steps": [
   {
    "name": "decide",
    "step_type": {
     "type": "Exec"
    },
    "description": "Applique la décision via l'API locale (0 token).",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "exec_command": "python3",
    "exec_args": [
     "-c",
     "@@script:workflows/gate_decide.py@@",
     "{{run_id}}",
     "{{decision}}",
     "{{comment}}"
    ],
    "exec_timeout_secs": 30
   }
  ],
  "actions": [],
  "safety": {
   "sandbox": false,
   "require_approval": false
  },
  "workspace_config": {
   "hooks": {},
   "require_isolation": false,
   "main_tree_read_only": true
  },
  "concurrency_limit": null,
  "exec_allowlist": [
   "python3"
  ]
 }
}