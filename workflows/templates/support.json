{
 "kind": "workflow",
 "key": "support",
 "definition": {
  "name": "Le Bureau · investiguer un message de support",
  "project_id": "@@kronn.project_id@@",
  "trigger": {
   "type": "Manual"
  },
  "variables": [
   {
    "name": "message_id",
    "label": "Message",
    "placeholder": "",
    "description": "Message du canal Support (relu dans le dataset support).",
    "required": true,
    "pattern": "^[0-9]{1,20}$",
    "source": null,
    "allow_manual_override": false
   },
   {
    "name": "project_id",
    "label": "Projet",
    "placeholder": "",
    "description": "Projet Kronn dont l'agent lit le code (« none » : sans projet).",
    "required": true,
    "source": null,
    "allow_manual_override": false
   },
   {
    "name": "comment",
    "label": "Commentaire",
    "placeholder": "Facultatif : une piste, un contexte, ce qu'il faut vérifier",
    "description": null,
    "required": false,
    "source": null,
    "allow_manual_override": false,
    "control": {
     "type": "textarea"
    }
   }
  ],
  "steps": [
   {
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "name": "open",
    "step_type": {
     "type": "Exec"
    },
    "description": "Relit le fil dans Teams (message et réponses, connecteur Microsoft 365), ouvre la discussion Kronn de l'investigation (state.disc, la même pour tous les postes) et pose le dossier du message : la demande, les réponses déjà dans le fil et ton commentaire (un appel au petit modèle pour relire le fil).",
    "exec_command": "python3",
    "exec_args": [
     "-c",
     "@@script:workflows/support.py@@",
     "open",
     "{{message_id}}",
     "{{project_id}}",
     "{{run.id}}",
     "{{comment}}"
    ],
    "exec_timeout_secs": 120
   },
   {
    "name": "mark",
    "step_type": {
     "type": "CollectApiData"
    },
    "description": "État des fils sans relevé : celui-ci passe « investigation en cours » sur la page tout de suite.",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "collect_api_data": {
     "sources": [
      {
       "alias": "snap",
       "quick_api_id": "",
       "quick_exec_id": "",
       "quick_exec": {
        "command": "python3",
        "args": [
         "-c",
         "@@script:workflows/support.py@@",
         "dataset"
        ],
        "timeout_secs": 60,
        "output_format": "json"
       },
       "required": true
      }
     ],
     "concurrent_limit": 1
    }
   },
   {
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "name": "publish_run",
    "step_type": {
     "type": "PublishPageData"
    },
    "description": "Remplace le dataset support.",
    "page_publish": {
     "page_id": "@@page_id@@",
     "writes": [
      {
       "dataset": "support",
       "operation": "replace",
       "value_from": "steps.mark.data.sources.snap"
      }
     ]
    }
   },
   {
    "name": "tri",
    "agent": "ClaudeCode",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "step_type": {
     "type": "SubWorkflow"
    },
    "description": "Poste 🏷 tri (sous-workflow, un agent) : il lit le dossier du message et y range son rapport.",
    "sub_workflow_id": "@@models.support_tri@@",
    "sub_workflow_variables": {
     "message_id": "{{message_id}}",
     "retours": "{{state.last_human_feedback ?? \"\"}}",
     "disc": "{{state.disc ?? \"\"}}"
    }
   },
   {
    "name": "logs",
    "agent": "ClaudeCode",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "step_type": {
     "type": "SubWorkflow"
    },
    "description": "Poste 🔎 logs (sous-workflow, un agent) : il lit le dossier du message et y range son rapport.",
    "sub_workflow_id": "@@models.support_logs@@",
    "sub_workflow_variables": {
     "message_id": "{{message_id}}",
     "retours": "{{state.last_human_feedback ?? \"\"}}",
     "disc": "{{state.disc ?? \"\"}}"
    }
   },
   {
    "name": "cause",
    "agent": "ClaudeCode",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "step_type": {
     "type": "SubWorkflow"
    },
    "description": "Poste 🧩 cause (sous-workflow, un agent) : il lit le dossier du message et y range son rapport.",
    "sub_workflow_id": "@@models.support_cause@@",
    "sub_workflow_variables": {
     "message_id": "{{message_id}}",
     "retours": "{{state.last_human_feedback ?? \"\"}}",
     "disc": "{{state.disc ?? \"\"}}"
    }
   },
   {
    "name": "reponse",
    "agent": "ClaudeCode",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "step_type": {
     "type": "SubWorkflow"
    },
    "description": "Poste ✉ réponse (sous-workflow, un agent) : il lit le dossier du message et y range son rapport. « Changements » à la gate reprend ici, ton commentaire en tête du dossier.",
    "sub_workflow_id": "@@models.support_reponse@@",
    "sub_workflow_variables": {
     "message_id": "{{message_id}}",
     "retours": "{{state.last_human_feedback ?? \"\"}}",
     "disc": "{{state.disc ?? \"\"}}"
    }
   },
   {
    "name": "relecture",
    "agent": "ClaudeCode",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "step_type": {
     "type": "SubWorkflow"
    },
    "description": "Poste 🧐 relecture (sous-workflow, un agent) : il lit le dossier du message et y range son rapport.",
    "sub_workflow_id": "@@models.support_relecture@@",
    "sub_workflow_variables": {
     "message_id": "{{message_id}}",
     "retours": "{{state.last_human_feedback ?? \"\"}}",
     "disc": "{{state.disc ?? \"\"}}"
    }
   },
   {
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "name": "draft",
    "step_type": {
     "type": "Exec"
    },
    "description": "La réponse du poste ✉ au format, numérotée (version). La relecture qui dit « revoir », ou une réponse sans section « emoji Libellé : … », la renvoie au poste ✉ (2 fois au plus, puis elle part à ta validation avec les remarques restées).",
    "exec_command": "python3",
    "exec_args": [
     "-c",
     "@@script:workflows/support.py@@",
     "draft",
     "{{run.id}}",
     "{{message_id}}"
    ],
    "exec_timeout_secs": 30,
    "on_result": [
     {
      "contains": "exit_3",
      "action": {
       "type": "Goto",
       "step_name": "reponse",
       "max_iterations": 4
      }
     }
    ]
   },
   {
    "name": "mark_draft",
    "step_type": {
     "type": "CollectApiData"
    },
    "description": "État des fils avec la réponse proposée et sa version : la fenêtre Support la montre à valider.",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "collect_api_data": {
     "sources": [
      {
       "alias": "snap",
       "quick_api_id": "",
       "quick_exec_id": "",
       "quick_exec": {
        "command": "python3",
        "args": [
         "-c",
         "@@script:workflows/support.py@@",
         "dataset"
        ],
        "timeout_secs": 60,
        "output_format": "json"
       },
       "required": true
      }
     ],
     "concurrent_limit": 1
    }
   },
   {
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "name": "publish_draft",
    "step_type": {
     "type": "PublishPageData"
    },
    "description": "Remplace le dataset support.",
    "page_publish": {
     "page_id": "@@page_id@@",
     "writes": [
      {
       "dataset": "support",
       "operation": "replace",
       "value_from": "steps.mark_draft.data.sources.snap"
      }
     ]
    }
   },
   {
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "name": "gate",
    "step_type": {
     "type": "Gate"
    },
    "description": "La réponse telle qu'elle sera postée en fil.",
    "gate_message": "{{steps.draft.data.stdout}}\n\n---\nRéponse proposée pour le fil Teams, postée sous ton nom avec la mention « Généré de manière automatique 🤖 ». **Approuver** : postée en fil. **Changements** : ton commentaire repart au poste ✉ Réponse (puis à la relecture), dans la même discussion. **Rejeter** : rien n'est posté, le fil passe « ignoré ».",
    "gate_request_changes_target": "reponse"
   },
   {
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "name": "post",
    "step_type": {
     "type": "Exec"
    },
    "description": "Réponse en fil (Microsoft Graph, jeton Azure CLI, sous ton nom), puis l'état des fils.",
    "exec_command": "python3",
    "exec_args": [
     "-c",
     "@@script:workflows/support.py@@",
     "post",
     "{{run.id}}"
    ],
    "exec_timeout_secs": 60,
    "exec_stdin": "{{steps.draft.data.stdout}}"
   },
   {
    "name": "mark_post",
    "step_type": {
     "type": "CollectApiData"
    },
    "description": "État des fils après la réponse postée : le fil passe « répondu ».",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "collect_api_data": {
     "sources": [
      {
       "alias": "snap",
       "quick_api_id": "",
       "quick_exec_id": "",
       "quick_exec": {
        "command": "python3",
        "args": [
         "-c",
         "@@script:workflows/support.py@@",
         "dataset"
        ],
        "timeout_secs": 60,
        "output_format": "json"
       },
       "required": true
      }
     ],
     "concurrent_limit": 1
    }
   },
   {
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "name": "publish",
    "step_type": {
     "type": "PublishPageData"
    },
    "description": "Remplace le dataset support : le fil passe « répondu ».",
    "page_publish": {
     "page_id": "@@page_id@@",
     "writes": [
      {
       "dataset": "support",
       "operation": "replace",
       "value_from": "steps.mark_post.data.sources.snap"
      }
     ]
    }
   }
  ],
  "actions": [],
  "safety": {
   "sandbox": false,
   "require_approval": false
  },
  "workspace_config": {
   "hooks": {},
   "require_isolation": false,
   "main_tree_read_only": true
  },
  "concurrency_limit": null,
  "guards": {
   "timeout_seconds": 86400,
   "max_llm_calls": 40,
   "loop_detection_max_revisits": 50
  },
  "exec_allowlist": [
   "python3"
  ]
 }
}
