{
 "kind": "workflow",
 "key": "payroll",
 "definition": {
  "name": "Le Bureau · fiche de paie (1 h)",
  "project_id": "@@kronn.project_id@@",
  "trigger": {
   "type": "Cron",
   "schedule": "7 4-20 * * *"
  },
  "steps": [
   {
    "name": "payroll",
    "step_type": {
     "type": "CollectApiData"
    },
    "description": "Tokens, runs et échecs par agent, jour et 7 jours (0 token).",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "collect_api_data": {
     "sources": [
      {
       "alias": "snap",
       "quick_api_id": "",
       "quick_exec_id": "",
       "quick_exec": {
        "command": "python3",
        "args": [
         "-c",
         "@@script:workflows/payroll_snapshot.py@@"
        ],
        "timeout_secs": 180,
        "output_format": "json"
       },
       "required": true
      }
     ],
     "concurrent_limit": 1
    }
   },
   {
    "name": "publish",
    "step_type": {
     "type": "PublishPageData"
    },
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "page_publish": {
     "page_id": "@@page_id@@",
     "writes": [
      {
       "dataset": "payroll",
       "operation": "replace",
       "value_from": "steps.payroll.data.sources.snap"
      }
     ]
    }
   }
  ],
  "actions": [],
  "safety": {
   "sandbox": false,
   "require_approval": false
  },
  "workspace_config": null,
  "concurrency_limit": null,
  "exec_allowlist": [
   "python3"
  ]
 }
}