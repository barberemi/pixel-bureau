{
 "kind": "workflow",
 "key": "support_poll",
 "definition": {
  "name": "Le Bureau · relevé du Support (15 min)",
  "project_id": "@@kronn.project_id@@",
  "trigger": {
   "type": "Cron",
   "schedule": "7-59/15 @@cron_hours@@ * * 1-5"
  },
  "steps": [
   {
    "name": "poll",
    "step_type": {
     "type": "CollectApiData"
    },
    "description": "Lit le canal Support par la CLI claude et le connecteur Microsoft 365 (petit modèle, un seul outil, un tour : environ 0,005 $), les réponses des fils qui ont bougé, l'état des investigations ; le dataset support. Sortie JSON (CollectApiData) : un vrai objet, que Kronn parcourt pour la liaison du bouton « Investiguer ».",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "collect_api_data": {
     "sources": [
      {
       "alias": "snap",
       "quick_api_id": "",
       "quick_exec_id": "",
       "quick_exec": {
        "command": "python3",
        "args": [
         "-c",
         "@@script:workflows/support.py@@",
         "poll"
        ],
        "timeout_secs": 200,
        "output_format": "json"
       },
       "required": true
      }
     ],
     "concurrent_limit": 1
    }
   },
   {
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "name": "publish",
    "step_type": {
     "type": "PublishPageData"
    },
    "description": "Remplace le dataset support de la page Le Bureau.",
    "page_publish": {
     "page_id": "@@page_id@@",
     "writes": [
      {
       "dataset": "support",
       "operation": "replace",
       "value_from": "steps.poll.data.sources.snap"
      }
     ]
    }
   }
  ],
  "actions": [],
  "safety": {
   "sandbox": false,
   "require_approval": false
  },
  "workspace_config": {
   "hooks": {},
   "require_isolation": false,
   "main_tree_read_only": true
  },
  "concurrency_limit": 1,
  "exec_allowlist": [
   "python3"
  ]
 }
}
