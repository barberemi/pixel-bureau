{
 "kind": "workflow",
 "key": "rejeu_bilan",
 "doc": "Bilan du rejeu de Palpatine : notes des rejeux, jeu témoin par version de la chaîne, écarts du juge, leçons du rejeu, coût (page « Rejeu · bilan », et le résumé de la fiche de Palpatine).",
 "definition": {
  "name": "Le Bureau · bilan du rejeu (1 h)",
  "project_id": "@@kronn.project_id@@",
  "trigger": {
   "type": "Cron",
   "schedule": "47 @@cron_hours@@ * * 1-5"
  },
  "steps": [
   {
    "name": "releve",
    "step_type": {
     "type": "Exec"
    },
    "description": "L'API Kronn : durée et coût de chaque run d'impl_rejeu (ses postes compris), un run fini relu une fois ; la proposition de leçons du rejeu attend-elle encore à sa gate (0 token).",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "exec_command": "python3",
    "exec_args": [
     "-c",
     "@@script:workflows/rejeu_bilan.py@@",
     "releve"
    ],
    "exec_timeout_secs": 300
   },
   {
    "name": "bilan",
    "step_type": {
     "type": "Exec"
    },
    "description": "Les rejeux rangés (rejeu.dossier) et le cache en dataset : notes, jeu témoin par version, écarts du juge, leçons (0 token).",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "exec_command": "python3",
    "exec_args": [
     "-c",
     "@@script:workflows/rejeu_bilan.py@@",
     "bilan"
    ],
    "exec_timeout_secs": 120
   },
   {
    "name": "publish",
    "step_type": {
     "type": "PublishPageData"
    },
    "description": "Remplace le dataset rejeu_bilan de la page « Rejeu · bilan ».",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "page_publish": {
     "page_id": "@@rejeu_bilan.page_id@@",
     "writes": [
      {
       "dataset": "rejeu_bilan",
       "operation": "replace",
       "value_from": "steps.bilan.data.stdout"
      }
     ]
    }
   },
   {
    "name": "resume",
    "step_type": {
     "type": "Exec"
    },
    "description": "Le résumé pour la fiche de Palpatine : jeu témoin, dernier rejeu, leçons (0 token).",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "exec_command": "python3",
    "exec_args": [
     "-c",
     "@@script:workflows/rejeu_bilan.py@@",
     "resume"
    ],
    "exec_timeout_secs": 120
   },
   {
    "name": "publish_resume",
    "step_type": {
     "type": "PublishPageData"
    },
    "description": "Remplace le dataset rejeu_resume de la page du Bureau.",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "page_publish": {
     "page_id": "@@page_id@@",
     "writes": [
      {
       "dataset": "rejeu_resume",
       "operation": "replace",
       "value_from": "steps.resume.data.stdout"
      }
     ]
    }
   }
  ],
  "actions": [],
  "safety": {
   "sandbox": false,
   "require_approval": false
  },
  "workspace_config": {
   "hooks": {},
   "require_isolation": false,
   "main_tree_read_only": true
  },
  "concurrency_limit": null,
  "exec_allowlist": [
   "python3"
  ]
 }
}
