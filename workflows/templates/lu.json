{
 "kind": "workflow",
 "key": "lu",
 "definition": {
  "name": "Le Bureau · lu",
  "project_id": "@@kronn.project_id@@",
  "trigger": {
   "type": "Manual"
  },
  "variables": [
   {
    "name": "mail_ref",
    "label": "Mail",
    "placeholder": "compte|Message-ID",
    "description": "Le mail à marquer lu : id du compte et Message-ID, séparés par |",
    "required": true,
    "source": null,
    "allow_manual_override": false,
    "control": {
     "type": "text"
    }
   }
  ],
  "actions": [],
  "safety": {
   "sandbox": false,
   "require_approval": false
  },
  "workspace_config": null,
  "concurrency_limit": null,
  "exec_allowlist": [
   "python3"
  ],
  "steps": [
   {
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "name": "read",
    "step_type": {
     "type": "Exec"
    },
    "description": "Marque le mail lu (appli Mail ou IMAP) puis relance le relevé du courrier : le porteur repart (0 token).",
    "exec_command": "python3",
    "exec_args": [
     "-c",
     "@@script:workflows/mail_snapshot.py@@",
     "read",
     "{{mail_ref}}"
    ],
    "exec_timeout_secs": 150
   }
  ]
 }
}