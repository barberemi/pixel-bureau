{
 "kind": "workflow",
 "key": "pages",
 "definition": {
  "name": "Le Bureau · pages",
  "project_id": "@@kronn.project_id@@",
  "trigger": {
   "type": "Manual"
  },
  "variables": [
   {
    "name": "page_code",
    "label": "Code page (déjà copié)",
    "placeholder": "Colle ici avec ⌘V",
    "description": "Le bouton « Ajouter » ou × de la fenêtre Mes pages Kronn vient de copier ce code : colle-le (⌘V) puis clique Lancer.",
    "required": true,
    "source": null,
    "allow_manual_override": false
   }
  ],
  "steps": [
   {
    "name": "save",
    "step_type": {
     "type": "Exec"
    },
    "description": "Valide le code et met à jour la liste de l'écran mural (dataset pagelist, 0 token).",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "exec_command": "python3",
    "exec_args": [
     "-c",
     "@@script:workflows/pages_save.py@@"
    ],
    "exec_timeout_secs": 30,
    "exec_stdin": "{{page_code}}"
   },
   {
    "name": "publish",
    "step_type": {
     "type": "PublishPageData"
    },
    "description": "Remplace le dataset pagelist de la page Le Bureau.",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "page_publish": {
     "page_id": "@@page_id@@",
     "writes": [
      {
       "dataset": "pagelist",
       "operation": "replace",
       "value_from": "steps.save.data.stdout"
      }
     ]
    }
   },
   {
    "name": "thumbs",
    "step_type": {
     "type": "CollectApiData"
    },
    "description": "Miniature de la page ajoutée, tout de suite (même script que le cron fiche de paie, 0 token).",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "collect_api_data": {
     "sources": [
      {
       "alias": "snap",
       "quick_api_id": "",
       "quick_exec_id": "",
       "quick_exec": {
        "command": "python3",
        "args": [
         "-c",
         "@@script:workflows/pages_snapshot.py@@"
        ],
        "timeout_secs": 180,
        "output_format": "json"
       },
       "required": true
      }
     ],
     "concurrent_limit": 1
    }
   },
   {
    "name": "publish_thumbs",
    "step_type": {
     "type": "PublishPageData"
    },
    "description": "Remplace le dataset bosspages (titres, miniatures, pages à ajouter).",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "page_publish": {
     "page_id": "@@page_id@@",
     "writes": [
      {
       "dataset": "bosspages",
       "operation": "replace",
       "value_from": "steps.thumbs.data.sources.snap"
      }
     ]
    }
   }
  ],
  "actions": [],
  "safety": {
   "sandbox": false,
   "require_approval": false
  },
  "workspace_config": {
   "hooks": {},
   "require_isolation": false,
   "main_tree_read_only": true
  },
  "concurrency_limit": null,
  "exec_allowlist": [
   "python3"
  ]
 }
}
