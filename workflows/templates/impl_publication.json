{
 "kind": "workflow",
 "key": "impl_publication",
 "doc": "Après ta relecture : PR prête, relecteurs demandés, lien dans le ticket.",
 "definition": {
  "name": "Le Bureau · chaîne · 📣 publication",
  "project_id": null,
  "trigger": {
   "type": "Manual"
  },
  "variables": [
   {
    "name": "ticket",
    "label": "Clé du ticket",
    "placeholder": "ABC-123",
    "description": "Ticket Jira sur la chaîne.",
    "required": true,
    "source": "user_input",
    "allow_manual_override": false,
    "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$"
   }
  ],
  "actions": [],
  "safety": {
   "sandbox": false,
   "require_approval": false
  },
  "workspace_config": null,
  "concurrency_limit": null,
  "exec_allowlist": [
   "python3"
  ],
  "steps": [
   {
    "name": "pret",
    "agent": "ClaudeCode",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "step_type": {
     "type": "Exec"
    },
    "description": "La PR sort du brouillon.",
    "exec_command": "python3",
    "exec_args": [
     "-c",
     "@@script:workflows/chaine.py@@",
     "pret"
    ],
    "exec_timeout_secs": 60,
    "external_effect": true
   },
   {
    "name": "reviewers",
    "agent": "ClaudeCode",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "step_type": {
     "type": "Exec"
    },
    "description": "Relecteurs du dépôt (réglage reviewers) ; le texte du commentaire Jira.",
    "exec_command": "python3",
    "exec_args": [
     "-c",
     "@@script:workflows/chaine.py@@",
     "reviewers"
    ],
    "exec_timeout_secs": 60,
    "external_effect": true
   },
   {
    "name": "jira",
    "agent": "ClaudeCode",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "step_type": {
     "type": "ApiCall"
    },
    "description": "Lien de la PR en commentaire du ticket (API REST v2).",
    "api_plugin_slug": "mcp-atlassian",
    "api_config_id": "@@jira.config_id@@",
    "api_endpoint_path": "/rest/api/2/issue/{{ticket}}/comment",
    "api_method": "POST",
    "api_body": {
     "body": "{{steps.reviewers.data.stdout}}"
    },
    "external_effect": true,
    "_requires": "jira"
   },
   {
    "name": "fin",
    "agent": "ClaudeCode",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "step_type": {
     "type": "Exec"
    },
    "description": "Fin de la chaîne pour ce ticket.",
    "exec_command": "python3",
    "exec_args": [
     "-c",
     "@@script:workflows/chaine.py@@",
     "fin"
    ],
    "exec_timeout_secs": 30
   }
  ]
 }
}
