{
 "kind": "workflow",
 "key": "team",
 "definition": {
  "name": "Le Bureau · équipe (Jira + GitHub)",
  "project_id": "@@kronn.project_id@@",
  "trigger": {
   "type": "Cron",
   "schedule": "*/10 @@cron_hours@@ * * 1-5"
  },
  "steps": [
   {
    "name": "sprint_info",
    "step_type": {
     "type": "ApiCall"
    },
    "description": "Sprint actif du board Delivery Front.",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "api_plugin_slug": "mcp-atlassian",
    "api_config_id": "@@jira.config_id@@",
    "api_endpoint_path": "/rest/agile/1.0/board/@@jira.board@@/sprint",
    "api_method": "GET",
    "api_query": {
     "state": "active"
    },
    "api_extract": {
     "path": "$.values[0]",
     "fallback": {},
     "fail_on_empty": true
    },
    "_requires": "jira"
   },
   {
    "name": "future_sprints",
    "step_type": {
     "type": "ApiCall"
    },
    "description": "Sprints futurs du board, dans son ordre : les 2 prochains sont préparés au sprint planning.",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "api_plugin_slug": "mcp-atlassian",
    "api_config_id": "@@jira.config_id@@",
    "api_endpoint_path": "/rest/agile/1.0/board/@@jira.board@@/sprint",
    "api_method": "GET",
    "api_query": {
     "state": "future"
    },
    "api_extract": {
     "path": "$.values",
     "fallback": [],
     "fail_on_empty": false
    },
    "_requires": "jira"
   },
   {
    "name": "planning_jql",
    "step_type": {
     "type": "Exec"
    },
    "description": "JQL des tickets des 2 prochains sprints sans story points (sprint planning).",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "exec_command": "python3",
    "exec_args": [
     "-c",
     "@@script:workflows/planning_jql.py@@"
    ],
    "exec_timeout_secs": 20,
    "_requires": "jira",
    "exec_stdin": "{{steps.future_sprints.data_json}}"
   },
   {
    "name": "planning_tickets",
    "step_type": {
     "type": "ApiCall"
    },
    "description": "Tickets des 2 prochains sprints sans story points, à estimer au sprint planning.",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "api_plugin_slug": "mcp-atlassian",
    "api_config_id": "@@jira.config_id@@",
    "api_endpoint_path": "/rest/api/3/search/jql",
    "api_method": "GET",
    "api_query": {
     "jql": "{{steps.planning_jql.data.stdout}}",
     "fields": "summary,status,assignee,issuetype,@@jira.sprint_field@@",
     "maxResults": "100"
    },
    "api_extract": {
     "path": "$.issues",
     "fallback": [],
     "fail_on_empty": false
    },
    "_requires": "jira"
   },
   {
    "name": "jira_team",
    "step_type": {
     "type": "ApiCall"
    },
    "description": "Tickets EW du sprint en cours, avec l'historique (changements de statut du jour) et la date de création.",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "api_plugin_slug": "mcp-atlassian",
    "api_config_id": "@@jira.config_id@@",
    "api_endpoint_path": "/rest/api/3/search/jql",
    "api_method": "GET",
    "api_query": {
     "jql": "project = @@jira.project@@ AND sprint in openSprints() ORDER BY updated DESC",
     "fields": "summary,status,assignee,issuetype,updated,@@jira.points_fields@@,created",
     "expand": "changelog",
     "maxResults": "100"
    },
    "api_extract": {
     "path": "$.issues",
     "fallback": [],
     "fail_on_empty": true
    },
    "_requires": "jira"
   },
   {
    "name": "jira_closed",
    "step_type": {
     "type": "ApiCall"
    },
    "description": "Tickets EW du dernier sprint fermé (21 j) : employé du sprint tant que le nouveau n'a rien livré. Sans historique (changelog) : il pesait ~7 Mo par run pour des changements de statut quasi inexistants hors sprint en cours.",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "api_plugin_slug": "mcp-atlassian",
    "api_config_id": "@@jira.config_id@@",
    "api_endpoint_path": "/rest/api/3/search/jql",
    "api_method": "GET",
    "api_query": {
     "fields": "summary,status,assignee,issuetype,updated,created,@@jira.points_fields@@,@@jira.sprint_field@@",
     "jql": "project = @@jira.project@@ AND sprint in closedSprints() AND sprint not in openSprints() AND updated >= -21d ORDER BY updated DESC",
     "maxResults": "100"
    },
    "api_extract": {
     "path": "$.issues",
     "fallback": [],
     "fail_on_empty": false
    },
    "_requires": "jira"
   },
   {
    "name": "work_written",
    "step_type": {
     "type": "ApiCall"
    },
    "description": "Tickets écrits ces 7 jours par la PO, la SM et la QA (travail sans ticket assigné).",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "api_plugin_slug": "mcp-atlassian",
    "api_config_id": "@@jira.config_id@@",
    "api_endpoint_path": "/rest/api/3/search/jql",
    "api_method": "GET",
    "api_query": {
     "jql": "project = @@jira.project@@ AND reporter in (@@jira.role_ids@@) AND created >= -7d ORDER BY created DESC",
     "fields": "summary,reporter,issuetype",
     "maxResults": "50"
    },
    "api_extract": {
     "path": "$.issues",
     "fallback": [],
     "fail_on_empty": false
    },
    "_requires": "jira.role_ids"
   },
   {
    "name": "work_po_triage",
    "step_type": {
     "type": "ApiCall"
    },
    "description": "Tickets triés par la PO ces 7 jours (sortis du statut de proposition).",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "api_plugin_slug": "mcp-atlassian",
    "api_config_id": "@@jira.config_id@@",
    "api_endpoint_path": "/rest/api/3/search/jql",
    "api_method": "GET",
    "api_query": {
     "jql": "project = @@jira.project@@ AND status CHANGED FROM \"@@jira.flow.triage_from@@\" BY \"@@jira.role.po@@\" DURING (-7d, now()) ORDER BY updated DESC",
     "fields": "summary,status",
     "maxResults": "50"
    },
    "api_extract": {
     "path": "$.issues",
     "fallback": [],
     "fail_on_empty": false
    },
    "_requires": "jira.role.po"
   },
   {
    "name": "work_sm_triage",
    "step_type": {
     "type": "ApiCall"
    },
    "description": "Tickets triés par la SM ces 7 jours (sortis du statut de proposition).",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "api_plugin_slug": "mcp-atlassian",
    "api_config_id": "@@jira.config_id@@",
    "api_endpoint_path": "/rest/api/3/search/jql",
    "api_method": "GET",
    "api_query": {
     "jql": "project = @@jira.project@@ AND status CHANGED FROM \"@@jira.flow.triage_from@@\" BY \"@@jira.role.sm@@\" DURING (-7d, now()) ORDER BY updated DESC",
     "fields": "summary,status",
     "maxResults": "50"
    },
    "api_extract": {
     "path": "$.issues",
     "fallback": [],
     "fail_on_empty": false
    },
    "_requires": "jira.role.sm"
   },
   {
    "name": "since",
    "step_type": {
     "type": "Exec"
    },
    "description": "Heure du dernier daily (jour ouvré précédent) : tickets créés depuis, et ceux du testeur.",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "exec_command": "python3",
    "exec_args": [
     "-c",
     "@@script:workflows/standup_since.py@@"
    ],
    "exec_timeout_secs": 20,
    "_requires": "jira"
   },
   {
    "name": "new_tickets",
    "step_type": {
     "type": "ApiCall"
    },
    "description": "Tickets créés depuis le dernier daily, avec leur auteur (la page garde ceux de l'équipe).",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "api_plugin_slug": "mcp-atlassian",
    "api_config_id": "@@jira.config_id@@",
    "api_endpoint_path": "/rest/api/3/search/jql",
    "api_method": "GET",
    "api_query": {
     "jql": "project = @@jira.project@@ AND created >= \"{{steps.since.data.stdout}}\" ORDER BY created DESC",
     "fields": "summary,reporter,issuetype,status,created",
     "maxResults": "50"
    },
    "api_extract": {
     "path": "$.issues",
     "fallback": [],
     "fail_on_empty": false
    },
    "_requires": "jira"
   },
   {
    "name": "work_qa_ok",
    "step_type": {
     "type": "ApiCall"
    },
    "description": "Tickets passés en test depuis le dernier daily (statut actuel : validé, réouvert ou encore en test).",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "api_plugin_slug": "mcp-atlassian",
    "api_config_id": "@@jira.config_id@@",
    "api_endpoint_path": "/rest/api/3/search/jql",
    "api_method": "GET",
    "api_query": {
     "jql": "project = @@jira.project@@ AND status WAS \"@@jira.flow.test@@\" DURING (\"{{steps.since.data.stdout}}\", now()) ORDER BY updated DESC",
     "fields": "summary,status",
     "maxResults": "50"
    },
    "api_extract": {
     "path": "$.issues",
     "fallback": [],
     "fail_on_empty": false
    },
    "_requires": "jira.role.qa"
   },
   {
    "name": "work_qa_back",
    "step_type": {
     "type": "ApiCall"
    },
    "description": "Tickets réouverts après test depuis le dernier daily.",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "api_plugin_slug": "mcp-atlassian",
    "api_config_id": "@@jira.config_id@@",
    "api_endpoint_path": "/rest/api/3/search/jql",
    "api_method": "GET",
    "api_query": {
     "jql": "project = @@jira.project@@ AND status CHANGED FROM \"@@jira.flow.test@@\" TO \"@@jira.flow.reopened@@\" AFTER \"{{steps.since.data.stdout}}\" ORDER BY updated DESC",
     "fields": "summary,status",
     "maxResults": "50"
    },
    "api_extract": {
     "path": "$.issues",
     "fallback": [],
     "fail_on_empty": false
    },
    "_requires": "jira.role.qa"
   },
   {
    "name": "github",
    "step_type": {
     "type": "Exec"
    },
    "description": "PR, releases et déploiements du dépôt suivi via gh, regroupés ; ne fait jamais échouer le run (sans gh : listes vides + erreur notée).",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "exec_command": "python3",
    "exec_args": [
     "-c",
     "@@script:workflows/github_snapshot.py@@"
    ],
    "exec_timeout_secs": 60
   },
   {
    "name": "shape",
    "step_type": {
     "type": "Exec"
    },
    "description": "Déterministe : regroupe tickets et PR par personne (lien GitHub et Jira par nom puis par clé EW).",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "exec_command": "python3",
    "exec_args": [
     "-c",
     "@@script:workflows/team_shape.py@@"
    ],
    "exec_timeout_secs": 60,
    "exec_stdin": "{\"sprint\":{{steps.sprint_info.data_json}},\"issues\":{{steps.jira_team.data_json}},\"closed\":{{steps.jira_closed.data_json}},\"github\":{{steps.github.data.stdout}},\"work\":{\"written\":{{steps.work_written.data_json}},\"po_triage\":{{steps.work_po_triage.data_json}},\"sm_triage\":{{steps.work_sm_triage.data_json}},\"qa_ok\":{{steps.work_qa_ok.data_json}},\"qa_back\":{{steps.work_qa_back.data_json}}},\"planning\":{\"sprints\":{{steps.future_sprints.data_json}},\"issues\":{{steps.planning_tickets.data_json}}},\"new_tickets\":{{steps.new_tickets.data_json}},\"roles\":{\"po\":\"@@jira.role.po@@\",\"sm\":\"@@jira.role.sm@@\",\"qa\":\"@@jira.role.qa@@\"}}"
   },
   {
    "name": "publish",
    "step_type": {
     "type": "PublishPageData"
    },
    "description": "Remplace le dataset team de la page Le Bureau.",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "page_publish": {
     "page_id": "@@page_id@@",
     "writes": [
      {
       "dataset": "team",
       "operation": "replace",
       "value_from": "steps.shape.data.stdout"
      }
     ]
    }
   },
   {
    "name": "actions",
    "step_type": {
     "type": "CollectApiData"
    },
    "description": "Tickets et PR visés par les boutons de la page (dataset actions, JSON plat), relus dans le dataset team.",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "collect_api_data": {
     "sources": [
      {
       "alias": "snap",
       "quick_api_id": "",
       "quick_exec_id": "",
       "quick_exec": {
        "command": "python3",
        "args": [
         "-c",
         "@@script:workflows/actions_snapshot.py@@"
        ],
        "timeout_secs": 30,
        "output_format": "json"
       },
       "required": true
      }
     ],
     "concurrent_limit": 1
    }
   },
   {
    "name": "publish_actions",
    "step_type": {
     "type": "PublishPageData"
    },
    "description": "Publie le dataset actions.",
    "agent": "ClaudeCode",
    "prompt_template": "",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "page_publish": {
     "page_id": "@@page_id@@",
     "writes": [
      {
       "dataset": "actions",
       "operation": "replace",
       "value_from": "steps.actions.data.sources.snap"
      }
     ]
    }
   }
  ],
  "actions": [],
  "safety": {
   "sandbox": false,
   "require_approval": false
  },
  "workspace_config": null,
  "concurrency_limit": null,
  "exec_allowlist": [
   "python3",
   "gh"
  ]
 }
}
