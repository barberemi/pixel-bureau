{
 "kind": "workflow",
 "key": "impl",
 "doc": "Pose un ticket sur la chaîne d'implémentation : un bureau et une PR par dépôt (composants Jira), chacun dans le projet de son dépôt.",
 "definition": {
  "name": "Le Bureau · implémenter un ticket",
  "project_id": "@@kronn.project_id@@",
  "trigger": {
   "type": "Manual"
  },
  "variables": [
   {
    "name": "jira_ticket_key",
    "label": "Clé du ticket",
    "placeholder": "ABC-123",
    "description": "Ticket Jira à implémenter.",
    "required": true,
    "source": "user_input",
    "allow_manual_override": false,
    "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$"
   },
   {
    "name": "mode",
    "label": "Mode",
    "placeholder": "",
    "description": "plan : s'arrête au plan validé, en commentaire du ticket. complet : jusqu'à la PR. essai : tout, sans rien envoyer.",
    "required": false,
    "source": "user_input",
    "allow_manual_override": false,
    "control": {
     "type": "select",
     "options": [
      {
       "value": "plan",
       "label": "Plan seulement",
       "enabled": true
      },
      {
       "value": "complet",
       "label": "Jusqu'à la PR",
       "enabled": true
      },
      {
       "value": "essai",
       "label": "Essai sans effet (ni push, ni PR, ni Jira)",
       "enabled": true
      }
     ],
     "default_value": "plan"
    }
   },
   {
    "name": "depot",
    "label": "Dépôt (sinon : les composants)",
    "placeholder": "owner/depot",
    "description": "owner/dépôt (ou un nom de composant) pour un seul bureau ; vide : un bureau et une PR par composant Jira du ticket.",
    "required": false,
    "source": "user_input",
    "allow_manual_override": false
   },
   {
    "name": "reprise",
    "label": "Reprise",
    "placeholder": "",
    "description": "auto : si le dernier run de ce ticket sur ce dépôt a échoué, la chaîne reprend là où il s'est arrêté (dossier et branche gardés). oui : reprendre quoi qu'il arrive (ex. après un plan seulement). non : repartir de zéro.",
    "required": false,
    "source": "user_input",
    "allow_manual_override": false,
    "control": {
     "type": "select",
     "options": [
      {
       "value": "auto",
       "label": "Auto (reprend après un échec)",
       "enabled": true
      },
      {
       "value": "oui",
       "label": "Reprendre là où le run d'avant s'est arrêté",
       "enabled": true
      },
      {
       "value": "non",
       "label": "Repartir de zéro",
       "enabled": true
      }
     ],
     "default_value": "auto"
    }
   }
  ],
  "actions": [],
  "safety": {
   "sandbox": false,
   "require_approval": false
  },
  "workspace_config": {
   "hooks": {},
   "require_isolation": false,
   "main_tree_read_only": true
  },
  "concurrency_limit": null,
  "exec_allowlist": [
   "python3"
  ],
  "steps": [
   {
    "name": "ticket",
    "agent": "ClaudeCode",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "step_type": {
     "type": "ApiCall"
    },
    "description": "Composants du ticket : ils donnent le dépôt.",
    "api_plugin_slug": "mcp-atlassian",
    "api_config_id": "@@jira.config_id@@",
    "api_endpoint_path": "/rest/api/2/issue/{{jira_ticket_key}}",
    "api_method": "GET",
    "api_query": {
     "fields": "summary,components"
    },
    "_requires": "jira"
   },
   {
    "name": "lance",
    "agent": "ClaudeCode",
    "mode": {
     "type": "Normal"
    },
    "output_format": {
     "type": "FreeText"
    },
    "step_type": {
     "type": "Exec"
    },
    "description": "Un dépôt par composant Jira, son projet Kronn, un passage par ticket et par dépôt, puis une chaîne par dépôt (0 token).",
    "exec_command": "python3",
    "exec_args": [
     "-c",
     "@@script:workflows/chaine.py@@",
     "lance",
     "{{jira_ticket_key}}",
     "{{mode}}",
     "{{depot}}",
     "{{reprise ?? \"auto\"}}"
    ],
    "exec_timeout_secs": 180,
    "exec_stdin": "{{steps.ticket.data_json ?? \"null\"}}"
   }
  ]
 }
}
